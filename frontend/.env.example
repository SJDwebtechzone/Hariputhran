# Frontend Environment Variables Template
# Copy this file to .env and replace with production values

# Backend API Base URL (e.g., https://api.hariputhranenterprises.com or /api if proxied)
VITE_API_URL=http://localhost:5000

# Public Production Website URL (used for Canonical, OpenGraph, JSON-LD, Sitemap)
VITE_SITE_URL=https://hariputhranenterprises.com

