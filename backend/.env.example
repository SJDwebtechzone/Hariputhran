# =============================================================================
# Backend Environment Configuration Template
# Copy to .env and configure for development / production
# =============================================================================

# Server Environment (set to production on the hosting server)
PORT=5000
NODE_ENV=development

# CORS Allowed Origins (Comma-separated list of exact domains allowed in production)
ALLOWED_ORIGINS=https://hariputhranenterprises.com,https://www.hariputhranenterprises.com

# PostgreSQL Connection (Use DATABASE_URL or individual DB_* parameters)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=Hariputhiran

# Database SSL & Pool Configuration
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# Authentication (Minimum 32 random characters in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# SMTP Email Configuration (Nodemailer - SMTP account must belong to the same domain)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password
MAIL_FROM=Hariputhran Enterprises <anand@hariputhranenterprises.com>
ADMIN_NOTIFY_EMAIL=anand@hariputhranenterprises.com

# Email Testing (true = log only, no email is sent; must be false or unset in production)
MAIL_DRY_RUN=false

# Frontend Base URL (Used in reset links and notifications)
FRONTEND_URL=https://hariputhranenterprises.com
